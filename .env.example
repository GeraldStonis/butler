# Required
DISCORD_TOKEN=your-bot-token-here
OLLAMA_API_KEY=your-ollama-api-key
OWNER_ID=your-discord-user-id

# LLM
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Identity and activity
OWNER_ALIASES=ronix,roni,ronyx,ronnie,icosa,icosahedron,icosahedronix,icosahedronixon
OWNER_AWAY_AFTER_SECONDS=300
ENABLE_NATURAL_OWNER_ACTIONS=true

# Storage and memory
DB_PATH=nixi.db
CONTEXT_WINDOW_SIZE=100
SUMMARY_THRESHOLD=50

# Owner-only search and media providers
TAVILY_API_KEY=
# Optional legacy search provider (used only when Tavily is not configured)
BRAVE_SEARCH_API_KEY=
TENOR_API_KEY=
GIPHY_API_KEY=
MEDIA_SAFE_MODE=true
AUTOMATIC_MEDIA_ENABLED=true
AUTOMATIC_MEDIA_COOLDOWN_SECONDS=180
AUTOMATIC_MEDIA_CHANCE=0.3

# Morning news
MORNING_NEWS_ENABLED=false
MORNING_NEWS_CHANNEL_ID=
MORNING_NEWS_TIME=08:00
MORNING_NEWS_TIMEZONE=Asia/Kolkata
MORNING_NEWS_TOPICS=world,india,technology,cybersecurity

# Dead chat nudges
DEAD_CHAT_ENABLED=false
DEAD_CHAT_IDLE_SECONDS=60
DEAD_CHAT_CHANNEL_IDS=

# Random server sticker spam
STICKER_SPAM_ENABLED=false
STICKER_SPAM_CHANNEL_ID=
STICKER_SPAM_INTERVAL_SECONDS=60

# Independent random memes, roughly every 4-6 minutes.
MEME_DROP_ENABLED=true
# Blank uses STICKER_SPAM_CHANNEL_ID.
MEME_DROP_CHANNEL_ID=
MEME_DROP_INTERVAL_SECONDS=300
