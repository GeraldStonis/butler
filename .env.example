# Required
DISCORD_TOKEN=your-bot-token-here
OLLAMA_API_KEY=your-ollama-api-key
OWNER_ID=your-discord-user-id

# LLM
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b
# Gemma 4: false for quick replies, true to enable thinking.
# GPT-OSS alternative: OLLAMA_MODEL=gpt-oss:120b; OLLAMA_THINKING_LEVEL=low.
OLLAMA_THINKING_LEVEL=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONCURRENT=3

# Identity and activity
OWNER_ALIASES=ronix,roni,ronyx,ronnie,icosa,icosahedron,icosahedronix,icosahedronixon
OWNER_AWAY_AFTER_SECONDS=300
OWNER_MENTION_COOLDOWN_SECONDS=600
FOLLOWUP_WINDOW_SECONDS=90
# Legacy name: enables natural-language tools for guests and the owner.
ENABLE_NATURAL_OWNER_ACTIONS=true

# Storage and memory
DB_PATH=nixi.db
CONTEXT_WINDOW_SIZE=100
SUMMARY_THRESHOLD=50
CONTEXT_MESSAGE_LIMIT=35
CONTEXT_CHAR_BUDGET=10000

# Owner-only search and media providers
TAVILY_API_KEY=
# Optional legacy search provider (used only when Tavily is not configured)
BRAVE_SEARCH_API_KEY=
TENOR_API_KEY=
GIPHY_API_KEY=
# Optional preferred renderer for generated static memes; Bearer API key.
IMGFLIP_API_KEY=
# Paid Imgflip API Premium endpoint. Leave false to prevent billable GIF calls.
IMGFLIP_GIF_CAPTIONS_ENABLED=false
IMGFLIP_GIF_DAILY_LIMIT=3
MEDIA_SAFE_MODE=true
AUTOMATIC_MEDIA_ENABLED=true
AUTOMATIC_MEDIA_COOLDOWN_SECONDS=45
AUTOMATIC_MEDIA_CHANCE=0.95

# Optional Cloudflare avatar caricatures. Keep the real token out of Git/chat.
# Members are eligible by default; their avatar/roasting/media opt-outs apply.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AVATAR_EDITS_ENABLED=true
AVATAR_EDIT_CHANCE=0.2
AVATAR_EDIT_COOLDOWN_SECONDS=3600
AVATAR_EDIT_DAILY_LIMIT=10
AVATAR_EDIT_TIMEOUT_SECONDS=30

# Morning news
MORNING_NEWS_ENABLED=false
MORNING_NEWS_CHANNEL_ID=
MORNING_NEWS_TIME=08:00
MORNING_NEWS_TIMEZONE=Asia/Kolkata
MORNING_NEWS_TOPICS=world,india,technology,cybersecurity

# Dead chat nudges
DEAD_CHAT_ENABLED=false
DEAD_CHAT_IDLE_SECONDS=300
DEAD_CHAT_CHANNEL_IDS=
# Dead-chat pings only; uses SERVER_TIMEZONE. Blank disables this window.
DEAD_CHAT_QUIET_HOURS=00:00-08:00

# Random server sticker spam
# False also stops scheduled memes in STICKER_SPAM_CHANNEL_ID.
STICKER_SPAM_ENABLED=false
STICKER_SPAM_CHANNEL_ID=
STICKER_SPAM_INTERVAL_SECONDS=60
# Scheduled posts in STICKER_SPAM_CHANNEL_ID; uses SERVER_TIMEZONE.
# Blank disables the spam-channel-specific quiet window.
SPAM_QUIET_HOURS=00:00-08:00

# Random memes, roughly every 4-6 minutes. False stops scheduled memes everywhere.
MEME_DROP_ENABLED=true
# Blank uses STICKER_SPAM_CHANNEL_ID and requires STICKER_SPAM_ENABLED=true.
# A different channel keeps meme drops independent of sticker spam.
MEME_DROP_CHANNEL_ID=
MEME_DROP_INTERVAL_SECONDS=300

# Free games and independently captioned cats; no additional API keys needed.
ACTIVITIES_ENABLED=true
# Games are owner-requested only; dead-chat revival uses roast-and-ping nudges.
# Shared spacing for unsolicited memes/music/nudges; sticker spam is separate.
AUTONOMOUS_MIN_GAP_SECONDS=120
# Optional local-time silence for all routine autonomous posts.
# Example: 23:00-08:00. Blank disables quiet hours.
QUIET_HOURS=
SERVER_TIMEZONE=Asia/Kolkata

# Rare native YouTube posts: one 10% chance after 10-15 minutes without humans.
MUSIC_DROP_ENABLED=true
# Blank uses DEAD_CHAT_CHANNEL_IDS; comma-separated channel IDs otherwise.
MUSIC_CHANNEL_IDS=
# Relative paths resolve from the bot's working directory.
SONGS_PATH=songs_data.json
